# 1. Please put the value in double quotes to avoid problems.
# 2. To use the file, you need to map the file to `/.env` in the container.

# RCLONE_BACKUP_SITE_NAME="Rclone Backup"
# Optional Web Basic Auth. Set both values to enable it; leave both commented
# to keep authentication disabled. Prefer RCLONE_BACKUP_PASSWORD_FILE when the
# password is provided as a Docker secret.
# RCLONE_BACKUP_USER="admin"
# RCLONE_BACKUP_PASSWORD="change-me"
# RCLONE_BACKUP_PASSWORD_FILE="/run/secrets/web-password"

# RCLONE_REMOTE_NAME="RcloneBackup"
# RCLONE_REMOTE_DIR="/RcloneBackup/"
# RCLONE_GLOBAL_FLAG=""
# CRON="5 * * * *"
# ZIP_ENABLE="TRUE"
# ZIP_PASSWORD="123456"
# ZIP_TYPE="zip"
# BACKUP_FILE_SUFFIX="%Y%m%d"
# BACKUP_KEEP_DAYS="0"
# BACKUP_KEEP_COUNT="0"
# PING_URL=""
# MAIL_SMTP_ENABLE="FALSE"
# MAIL_SMTP_VARIABLES=""
# MAIL_TO=""
# MAIL_WHEN_SUCCESS="TRUE"
# MAIL_WHEN_FAILURE="TRUE"
# TIMEZONE="UTC"
